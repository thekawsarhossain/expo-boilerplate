{
  "name": "expo-boilerplate",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "description": "Production-ready Expo (SDK 54) + React Native boilerplate with Expo Router, TanStack Query and an offline SQLite cache",
  "homepage": "https://github.com/thekawsarhossain/expo-boilerplate#readme",
  "repository": {
    "type": "git",
