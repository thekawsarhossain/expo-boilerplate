  "license": "MIT",
  "scripts": {
    "dev": "expo start",
    "dev:android": "expo start -c --android",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:web": "expo export --platform web",
    "format": "biome check --no-errors-on-unmatched --apply .",
    "typecheck": "tsc --noEmit",
    "expo-check": "expo install --check"
